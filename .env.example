# Ground Truth Network - Environment Variables
# Copy to .env and fill in real values before running docker-compose up

# ─── NAS ────────────────────────────────────────────────────────────────────
NAS_IP=192.168.100.202
TZ=America/Chicago

# ─── Camera (Reolink TrackMix) ──────────────────────────────────────────────
CAMERA_IP=192.168.100.131
CAMERA_USER=admin
CAMERA_PASSWORD=your_camera_password_here

# ─── InfluxDB ───────────────────────────────────────────────────────────────
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=your_secure_influxdb_password
INFLUXDB_TOKEN=your_secure_influxdb_token_32chars_min

# ─── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password

# ─── Home Assistant ─────────────────────────────────────────────────────────
HA_TOKEN=your_long_lived_access_token_here

# ─── Star Patrol / Golden Scan ───────────────────────────────────────────────
# Compass bearing (degrees) the zoom lens faces when pan=0. Run --calibrate to find it.
STAR_HOME_AZ=0.0
# Minimum target altitude above horizon (degrees); higher = less atmosphere
STAR_MIN_ALT=20.0
# Seconds to dwell at each target (pan/tilt settle + exposure lock)
STAR_DWELL_SEC=10
# Snapshots captured per target
STAR_SNAPS=4
# Shutter speed in microseconds (500000 = 0.5 s, the TrackMix practical max)
STAR_EXPOSURE_US=500000
# Gain 0–100 (80 is a good balance of brightness vs noise)
STAR_GAIN=80
# Output directory for night sky snapshots
STAR_SNAP_DIR=/volume1/highlights/stars
# Elevation above sea level in meters (for ephem accuracy)
ELEVATION=300

# Golden-hour scan settings
GOLDEN_SNAP_DIR=/volume1/highlights/golden_hour
GOLDEN_DWELL_SEC=6
GOLDEN_SNAPS=2

# ─── Highlight Curator ───────────────────────────────────────────────────────
# Your location (decimal degrees) for sunrise/sunset golden-hour detection
LATITUDE=39.8
LONGITUDE=-98.5
# Minutes before/after sunrise or sunset that qualify as "golden hour"
GOLDEN_MINUTES=45
# Minimum Frigate confidence score to flag as a highlight (0.0–1.0)
MIN_SCORE=0.60

# ─── Stock Triage ────────────────────────────────────────────────────────────
# Location slug used in output filenames and directory structure.
# Change this when deploying to a second camera site.
LOCATION_LABEL=wimberley

# "batch" for one-time full-catalog scan (exits when done).
# "daemon" for ongoing watch mode (default for the running container).
TRIAGE_MODE=daemon

# Minimum megapixels for stock eligibility (Adobe/Shutterstock require ~4MP).
MIN_RESOLUTION_MP=4.0

# Fraction of image height to scan for overlay text.
OCR_TOP_PCT=0.15
OCR_BOTTOM_PCT=0.10

# ─── Audio Scout ─────────────────────────────────────────────────────────────
BIRDNET_CONFIDENCE=0.70      # Min BirdNET confidence to record (0–1)
YAMNET_CONFIDENCE=0.75       # Min YAMNet confidence to record (0–1)
AUDIO_SUBMIT_MODE=off        # off | auto | manual
EBIRD_API_KEY=               # Get at https://ebird.org/api/keygen
RARE_SPECIES_PUSH=false      # true to enable push notifications for rare species
